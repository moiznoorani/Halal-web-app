{
  "name": "Halal Restaurant Finder",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "18" }
  },

  // Forward frontend and backend ports
  "forwardPorts": [3000, 3001, 5432],
  "portsAttributes": {
    "3000": { "label": "React Frontend", "onAutoForward": "openBrowser" },
    "3001": { "label": "Express API",    "onAutoForward": "silent" },
    "5432": { "label": "PostgreSQL",     "onAutoForward": "silent" }
  },

  // Run after the container starts
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // VS Code extensions
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "ms-vscode.vscode-node-azure-pack"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "tailwindCSS.includeLanguages": { "javascript": "javascript", "javascriptreact": "javascriptreact" }
      }
    }
  }
}
